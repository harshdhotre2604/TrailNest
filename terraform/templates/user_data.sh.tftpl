#!/bin/bash
# Runs once, on every instance the Auto Scaling Group ever launches (including
# replacements during a GitHub Actions instance refresh). Turns a bare Ubuntu
# boot into a fully working TrailNest node with zero manual steps.
set -euo pipefail
exec > >(tee /var/log/trailnest-boot.log) 2>&1

echo "=== TrailNest boot script starting: $(date) ==="

curl -fsSL https://get.docker.com | sh
usermod -aG docker ubuntu
apt-get update -y
apt-get install -y mysql-client unzip

# The plain Ubuntu AMI has no AWS CLI at all — confirmed the hard way (every
# instance failed identically at the first `aws` call below until this was
# added). Not an apt package; install the official v2 bundle.
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/awscliv2.zip /tmp/aws

# --- fetch secrets: this instance's IAM role permits reading only these
# three parameters (see terraform/iam.tf) ---
DB_PASSWORD=$(aws ssm get-parameter --region ${aws_region} --name /trailnest/db_password --with-decryption --query Parameter.Value --output text)
JWT_SECRET=$(aws ssm get-parameter --region ${aws_region} --name /trailnest/jwt_secret --with-decryption --query Parameter.Value --output text)
GEMINI_API_KEY=$(aws ssm get-parameter --region ${aws_region} --name /trailnest/gemini_key --with-decryption --query Parameter.Value --output text)
if [ "$GEMINI_API_KEY" = "unset" ]; then GEMINI_API_KEY=""; fi

git clone https://github.com/harshdhotre2604/TrailNest.git /home/ubuntu/TrailNest
cd /home/ubuntu/TrailNest

cat > .env <<EOF
DB_HOST=${rds_endpoint}
DB_PORT=3306
DB_USER=${db_username}
DB_PASSWORD=$DB_PASSWORD
DB_NAME=${db_name}
JWT_SECRET=$JWT_SECRET
CORS_ORIGIN=http://${alb_dns_name}
NEXT_PUBLIC_API_URL=http://${alb_dns_name}/api
GEMINI_API_KEY=$GEMINI_API_KEY
# docker-compose.rds.yml disables the local db service entirely, but the base
# docker-compose.yml still requires this variable to *exist* during Compose's
# variable interpolation, even for a service that never starts. Unused.
DB_ROOT_PASSWORD=unused-service-never-starts
DOCKERHUB_USERNAME=${dockerhub_username}
EOF

# --- load schema/seed against RDS, but ONLY on a genuinely fresh database.
# schema.sql (CREATE TABLE IF NOT EXISTS) and seed_amenities.sql (INSERT
# IGNORE against a real unique key) are safe to re-run. db/seed.sql is NOT:
# its owners/properties/leads inserts are plain INSERT INTO with no unique
# key on properties/leads at all, so a second run doesn't just no-op --
# it errors on owners.email's unique constraint (confirmed: this is exactly
# what killed every instance after the first one to seed successfully) and,
# for properties/leads, would have silently duplicated rows instead. RDS has
# no equivalent of Docker's docker-entrypoint-initdb.d "only on an empty
# volume" behavior, so that check is done by hand here instead.
export MYSQL_PWD="$DB_PASSWORD"
TABLE_EXISTS=$(mysql -h ${rds_endpoint} -u ${db_username} -N -e \
  "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = '${db_name}' AND table_name = 'owners';")
if [ "$TABLE_EXISTS" = "0" ]; then
  echo "Fresh database detected -- loading schema and seed data"
  mysql -h ${rds_endpoint} -u ${db_username} ${db_name} < db/schema.sql
  mysql -h ${rds_endpoint} -u ${db_username} ${db_name} < db/seed.sql
  mysql -h ${rds_endpoint} -u ${db_username} ${db_name} < db/seed_amenities.sql
else
  echo "Database already initialized -- skipping schema/seed load"
fi
unset MYSQL_PWD

# Pull the pre-built images GitHub Actions already pushed — nothing gets
# built on this instance. (docker login isn't needed here: the repos are
# public. If they were ever made private, this instance's role would also
# need a Docker Hub credential fetched from SSM the same way the three
# secrets above are.)
docker compose -f docker-compose.yml -f docker-compose.rds.yml -f docker-compose.images.yml pull
docker compose -f docker-compose.yml -f docker-compose.rds.yml -f docker-compose.images.yml up -d

echo "=== TrailNest boot script finished: $(date) ==="
