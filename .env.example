# Copy to .env (same directory as docker-compose.yml) before running `docker compose up`.
# docker compose reads .env automatically for variable substitution below.

DB_ROOT_PASSWORD=change-me-root
DB_USER=trailnest
DB_PASSWORD=change-me-app-user
DB_NAME=trailnest_dev

JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000

# Must be reachable from the browser (baked into the frontend build), unlike the
# backend's internal container-to-container URL, which is hardcoded in compose.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional — Google Gemini API key for the "Polish with AI" / "AI Form Helper"
# features. Get one at aistudio.google.com. Leave blank to run without AI; both
# endpoints fall back to a "temporarily unavailable" message. Never commit the
# real value.
GEMINI_API_KEY=
