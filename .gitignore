# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Env files
.env
.env.local
.env.production
frontend/.env*
backend/.env
backend/.env.production
!*.env.example
!frontend/.env.local.example

# Next.js build output
frontend/.next/
frontend/out/

# Runtime-uploaded property media (persisted via the backend_uploads Docker
# volume in prod; local files are dev-only test data)
backend/uploads/

# TLS material and ACME challenge scratch (created on the server by certbot)
nginx/letsencrypt/*
nginx/certbot-www/*
!nginx/letsencrypt/.gitkeep
!nginx/certbot-www/.gitkeep

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Docker (added later)
docker-compose.override.yml

# Terraform local state/cache/secrets — .terraform.lock.hcl IS committed
# (pins the provider version) but everything below is machine/account-specific
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfvars
terraform/*.tfplan
terraform/crash.log
